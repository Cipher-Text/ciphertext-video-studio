{
  "name": "ciphertext-video-studio",
  "version": "0.1.0",
  "packageManager": "pnpm@12.3.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "studio": "remotion studio src/video/index.tsx",
    "build": "vite build && remotion bundle src/video/index.tsx",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "render:demo": "remotion render src/video/index.tsx CipherTextDemo out/demo.mp4",
    "render:project": "remotion render src/video/index.tsx CipherTextProject",
    "render": "remotion render src/video/index.tsx"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.76.0",
    "@remotion/cli": "4.0.534",
    "@remotion/player": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "d3-scale": "^4.0.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/d3-scale": "^4.0.9",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
