# Optional; only explicit speech preview/generation requests send text to Azure.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Comma-separated loopback frontend origins allowed to call the local API.
CIPHERTEXT_FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# Defaults to ./data/ciphertext.sqlite.
CIPHERTEXT_DATA_DIR=./data
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
STUDIO_DATA_DIR=./storage
